{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Streamline frontend",
      "type": "chrome",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9222,
      "urlFilter": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "name": "Start Streamline and attach",
      "type": "chrome",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9222,
      "urlFilter": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "preLaunchTask": "Streamline: dev"
    },
    {
      "name": "Debug Streamline Go with stdin",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/streamline",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=dev",
      "args": ["-port", "8080"],
      "stdinFrom": "${workspaceFolder}/dataset/caddy_logs_full.txt",
      // "stdinFrom": "${workspaceFolder}/dataset/journald_logs_plain.txt",
      // "stdinFrom": "${workspaceFolder}/internal/parse/testdata/journald.jsonl",
      "console": "integratedTerminal",
      "showLog": false
    }
  ]
}
